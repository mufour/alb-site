ALB_DB_PASSWORD=replace_with_your_local_password
ALB_DB_USER=alb_user
ALB_DB_URL=jdbc:postgresql://localhost:5433/alb_db
# Administration login credentials (never commit a real password)
ALB_ADMIN_USERNAME=admin
ALB_ADMIN_PASSWORD=replace_with_a_unique_local_password
# False for local HTTP only. Set true behind HTTPS in production.
ALB_SESSION_COOKIE_SECURE=false
